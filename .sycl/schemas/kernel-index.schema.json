{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sycl-agent kernel index",
  "type": "object",
  "properties": {
    "schema": { "type": "string" },
    "kernels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string" },
          "source_lang": {
            "type": "string",
            "enum": ["cuda", "triton"],
            "default": "cuda",
            "description": "Original kernel language. Absent = cuda."
          },
          "target_style": {
            "type": "string",
            "enum": ["plain-sycl", "sycl-tla"],
            "default": "plain-sycl",
            "description": "SYCL target style. Absent = plain-sycl."
          },
          "status": {
            "type": "string",
            "enum": ["pending", "migrated", "skipped", "needs-reference", "optimizing"]
          },
          "risk": { "type": "string", "enum": ["low", "medium", "high"] },
          "detail": { "type": "string", "description": "Path to kernels/<id>.json" },
          "notes": { "type": "string" }
        },
        "required": ["id", "source", "status"]
      }
    },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "required": ["kernels"]
}
