{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sycl-agent LOC rollup",
  "description": "GENERATED by .sycl/scripts/loc.sh rollup from kernels/<id>.json `loc` blocks plus a project-wide scan. Answers 'how much CUDA/Triton code did this migration actually cover, and how much SYCL did it take'. Never hand-edit: re-run `loc.sh all`.",
  "type": "object",
  "properties": {
    "schema": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "totals": {
      "type": "object",
      "properties": {
        "source_migrated": {
          "type": "object",
          "description": "Original CUDA/Triton lines covered by migrated kernels, with per-file spans MERGED so a header shared by several kernels is counted once.",
          "properties": {
            "code": { "type": "integer" },
            "raw": { "type": "integer" },
            "files": { "type": "integer" }
          }
        },
        "sycl_written": {
          "type": "object",
          "properties": {
            "code": { "type": "integer" },
            "raw": { "type": "integer" },
            "files": { "type": "integer" }
          }
        },
        "by_source_lang": {
          "type": "object",
          "description": "Per-language attribution (cuda|triton). Sums per kernel, so shared lines MAY be double-counted here; use source_migrated for the headline.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "code": { "type": "integer" },
              "raw": { "type": "integer" },
              "kernels": { "type": "integer" }
            }
          }
        },
        "kernels_measured": { "type": "integer" },
        "kernels_total": { "type": "integer", "description": "Non-skipped kernels in the index." },
        "sycl_per_source_ratio": { "type": "number", "description": "sycl_written.code / source_migrated.code." },
        "coverage_pct_of_project": { "type": "number", "description": "source_migrated.code as a % of all CUDA/Triton code lines found by the project scan." }
      }
    },
    "project": {
      "type": "object",
      "description": "Whole-project scan (context for coverage): every .cu/.cuh file, every Triton .py, and every SYCL .cpp/.hpp.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "code": { "type": "integer" },
          "raw": { "type": "integer" },
          "files": { "type": "integer" }
        }
      }
    },
    "kernels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "measured": { "type": "boolean" },
          "status": { "type": "string" },
          "source_lang": { "type": "string" },
          "source_code": { "type": "integer" },
          "source_raw": { "type": "integer" },
          "sycl_code": { "type": "integer" },
          "sycl_raw": { "type": "integer" },
          "unresolved": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["id", "measured"]
      }
    },
    "note": { "type": "string" }
  },
  "required": ["totals"]
}
