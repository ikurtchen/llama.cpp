    {
      "task_id": "opt_task_005",
      "kernel": "mul_mat_vec_q (MMVQ)",
      "step_id": "opt_002_001",
      "description": "Increase MMVQ work-group size from 32 to 256 + new mul_mat_vec_q_multicol kernel for non-IQ types at n=2..8",
      "outcome": "significant_speedup",
      "build_config": "Standard build (GGML_SYCL_F16=ON, no special defines)",
      "notes": "Two changes: (1) WG size 32->256 for all legacy MMVQ launchers, (2) new mul_mat_vec_q_multicol kernel for non-IQ quantized types when src1_ncols=2..8. IQ formats use old kernel templates with WG=256 (no multicol). The multicol kernel processes multiple output columns per work-group, dramatically improving efficiency for speculative decoding batch sizes.",
      "benchmark_comparison": {
        "test_case": "MUL_MAT(type_a=*,type_b=f32,m=4096,n=1..8,k=14336,bs=[1,1]) - MMVQ-relevant quantized types only",
        "baseline_log": "logs/b60_benchmark_20260307_194801.log",
        "new_log": "logs/b60_benchmark_20260308_050530.log",
        "summary_averages": {
          "n1_wg256_only": {
            "avg_speedup": 0.9939,
            "num_cases": 20,
            "description": "n=1: WG size increase only, no multicol"
          },
          "n2_8_all": {
            "avg_speedup": 2.132,
            "num_cases": 100,
            "description": "n=2..8: all quantized types"
          },
          "n2_8_non_iq_multicol": {
            "avg_speedup": 3.0652,
            "num_cases": 55,
            "description": "n=2..8: non-IQ types using multicol kernel"
          },
          "n2_8_iq_fallback": {
            "avg_speedup": 0.9915,
            "num_cases": 45,
            "description": "n=2..8: IQ types using legacy kernel with WG=256"
          },
